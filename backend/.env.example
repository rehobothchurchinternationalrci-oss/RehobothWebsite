# ============================================================
# Rehoboth Church International — Backend (Flask)
# Copier ce fichier vers .env en local.
# Sur Railway : renseigner ces cles dans l'onglet Variables du service.
# ============================================================

# ------------------------------------------------------------
# SUPABASE — Project Settings > API
# ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# FLASK
# ------------------------------------------------------------
FLASK_ENV=production
# PORT est injecte automatiquement par Railway — ne pas le definir la-bas.
# Sur Vercel, la notion n'existe pas (serverless) : ne pas la definir non plus.
PORT=5000

# ------------------------------------------------------------
# FRONTEND_URL — URL publique du site, sans slash final.
# Sert a construire les liens des emails (reinitialisation de mot de passe,
# onboarding des chefs de departement). Laisse a localhost, les mails envoyes
# depuis la production contiennent des liens morts.
#
# Production (Vercel) : https://rehoboth-website-three.vercel.app
#
# ⚠️ Ne suffit pas seul pour la reinitialisation de mot de passe : Supabase
# ignore le redirect_to si l'URL n'est pas dans sa liste blanche. Ajouter
#   https://rehoboth-website-three.vercel.app/reset-password
# dans Supabase > Authentication > URL Configuration > Redirect URLs,
# et y poser le Site URL sur https://rehoboth-website-three.vercel.app
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# CORS — origines autorisees, separees par des virgules.
# "*" autorise tout le monde (a eviter en production).
# Production (Vercel) : https://rehoboth-website-three.vercel.app
# Plusieurs origines : https://rehoboth-website-three.vercel.app,https://www.rehoboth.org
# ------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------
# RESEND (emails) — laisser vide pour desactiver l'envoi reel
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Adresse de contact recevant les messages du formulaire public
CHURCH_CONTACT_EMAIL=

# ------------------------------------------------------------
# RATE LIMITING — stockage des compteurs.
# "memory://" (defaut) : chaque worker gunicorn compte de son cote et les
# compteurs repartent a zero a chaque redeploiement. Suffisant pour freiner
# bruteforce et spam. Pour un decompte exact et partage entre workers,
# renseigner l'URL d'un Redis : redis://default:<mdp>@<hote>:<port>
#
# ⚠️ Sur Vercel (serverless), "memory://" rend le rate limiting inoperant :
# chaque instance a ses propres compteurs et repart de zero. Un Redis y est
# necessaire, pas optionnel — voir DEPLOYMENT-VERCEL.md.
# ------------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://

# ------------------------------------------------------------
# GUNICORN (optionnel — valeurs par defaut dans le Procfile)
# ------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
