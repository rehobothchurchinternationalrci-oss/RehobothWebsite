# ============================================================
# Rehoboth Church International — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Variables prefixed with VITE_ are exposed to the browser.
#
# IMPORTANT: Vite inlines these values at BUILD time, not at runtime.
# On Railway they must be set on the frontend service before the build runs
# (the Dockerfile reads them as build args). Changing them requires a redeploy.

# Flask Backend — in production, the public URL of the backend service:
#   https://<backend-service>.up.railway.app/api
VITE_API_BASE_URL=http://localhost:5000/api

# App metadata
VITE_APP_VERSION=1.0.0
